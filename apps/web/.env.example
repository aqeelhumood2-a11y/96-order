# Copy this file to .env.local and fill in your Firebase project's values.
# These are the Firebase client config values — not secret; safe in the
# browser bundle by design (Firebase enforces access via Security Rules and
# App Check, not by hiding this config). Find them in the Firebase console
# under Project settings > General > Your apps > SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the app at the local Firebase Emulator Suite
# (see `firebase.json` at the repo root) instead of your real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Server-side Firebase Admin credentials — optional. On a Google Cloud
# runtime (Cloud Run, Cloud Functions, GCE, Firebase App Hosting), leave all
# three unset: `infrastructure/firebase/admin.ts` falls back to Application
# Default Credentials automatically. On a non-GCP host (e.g. Vercel), where
# there's no metadata server for ADC to query, set all three from your
# service account JSON's `project_id` / `client_email` / `private_key`
# fields. Setting only one or two is treated as a misconfiguration and
# fails loudly at first use. Never commit the downloaded JSON file itself
# (see .gitignore's `*firebase-adminsdk*.json` pattern), never paste its
# contents into source code, and never put real values here.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Absolute origin of the deployed site — used for canonical URLs, Open
# Graph tags, sitemap.xml, and robots.txt. Falls back to a local dev origin
# when unset (see src/config/site.ts), so this is optional in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tap Payments secret key (test or live) — server-only, never exposed to
# the browser. Get one from https://www.tap.company after creating a
# merchant account. Left unset, `services/payments/dependencies.ts`
# automatically falls back to `FakeTapProvider` (see
# src/infrastructure/payments/tap/fake-tap-provider.ts) so local dev and
# CI never need a real Tap account. Never commit a real value here.
TAP_SECRET_KEY=

# Signs the guest-cart cookie (see src/lib/cart-cookie.ts) — any long
# random string, generated once per environment (e.g. `openssl rand -hex 32`).
# Rotating it invalidates every existing guest cart cookie (they'll simply
# get a fresh empty cart, not an error). Never commit a real value here.
CART_COOKIE_SECRET=

# Anthropic API key — server-only, optional. Powers the real AI Admin
# Assistant (src/infrastructure/ai/anthropic-assistant-provider.ts). Left
# unset, the assistant automatically falls back to a deterministic
# rules-based data digest (src/infrastructure/ai/rule-based-assistant-provider.ts)
# instead of failing — see the root README's Phase 8 section. Never commit
# a real value here.
ANTHROPIC_API_KEY=

# SMTP transactional email — server-only, optional, vendor-neutral (works
# with Amazon SES, SendGrid, Postmark, Mailgun, or any other SMTP-capable
# ESP; SMTP_FROM is the only ESP-specific value). Left unset,
# `services/email/dependencies.ts` falls back to `ConsoleEmailProvider`
# (logs the rendered email instead of delivering it) so local dev and CI
# never need real credentials. Never commit real values here.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Ninety Six Degrees Cafe <no-reply@example.com>"

# Shared secret for machine-to-machine job/integration routes
# (POST /api/jobs/retry-failed-emails, GET /api/integrations/orders/sync —
# see src/lib/verify-job-secret.ts), sent as `Authorization: Bearer <value>`.
# Any long random string. Left unset, both routes deny every request —
# never accidentally exposed with no auth. Never commit a real value here.
JOB_SECRET=
