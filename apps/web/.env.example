# Copy this file to .env.local and fill in your Firebase project's values.
# These are the Firebase client config values — not secret; safe in the
# browser bundle by design (Firebase enforces access via Security Rules and
# App Check, not by hiding this config). Find them in the Firebase console
# under Project settings > General > Your apps > SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the app at the local Firebase Emulator Suite
# (see `firebase.json` at the repo root) instead of your real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# No Admin SDK service-account variables belong here. Server-side Firebase
# Admin access uses Application Default Credentials instead — see
# src/infrastructure/firebase/admin.ts for how, and the root README for the
# one-time local setup command.

# Absolute origin of the deployed site — used for canonical URLs, Open
# Graph tags, sitemap.xml, and robots.txt. Falls back to a local dev origin
# when unset (see src/config/site.ts), so this is optional in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tap Payments secret key (test or live) — server-only, never exposed to
# the browser. Get one from https://www.tap.company after creating a
# merchant account. Left unset, `services/payments/dependencies.ts`
# automatically falls back to `FakeTapProvider` (see
# src/infrastructure/payments/tap/fake-tap-provider.ts) so local dev and
# CI never need a real Tap account. Never commit a real value here.
TAP_SECRET_KEY=

# Signs the guest-cart cookie (see src/lib/cart-cookie.ts) — any long
# random string, generated once per environment (e.g. `openssl rand -hex 32`).
# Rotating it invalidates every existing guest cart cookie (they'll simply
# get a fresh empty cart, not an error). Never commit a real value here.
CART_COOKIE_SECRET=
