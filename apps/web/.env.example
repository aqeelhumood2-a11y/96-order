# Copy this file to .env.local and fill in your Firebase project's values.
# These are the Firebase client config values — not secret; safe in the
# browser bundle by design (Firebase enforces access via Security Rules and
# App Check, not by hiding this config). Find them in the Firebase console
# under Project settings > General > Your apps > SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to point the app at the local Firebase Emulator Suite
# (see `firebase.json` at the repo root) instead of your real project.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# No Admin SDK service-account variables belong here. Server-side Firebase
# Admin access uses Application Default Credentials instead — see
# src/infrastructure/firebase/admin.ts for how, and the root README for the
# one-time local setup command.
