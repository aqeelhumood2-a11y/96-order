# Fixed, non-secret values for emulator-backed integration/e2e-auth test runs
# only (loaded via NODE_OPTIONS="--env-file=.env.test"). "demo-" prefixed
# project IDs are treated specially by the Firebase Emulator Suite as
# test-only and can never collide with a real GCP project — this is
# deliberately not the same id as whatever real project `.firebaserc`
# eventually points at for deployment.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-96order.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-96order
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-96order.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
