rules_version = '2';

// Phase 2 (auth/RBAC foundation) collections: `users`, `roles`, `auditLogs`,
// `system/bootstrap`, and `rateLimits` are all read and written exclusively
// by server-side code through the Firebase Admin SDK (see
// apps/web/src/infrastructure/firebase/repositories/*.ts and
// apps/web/scripts/bootstrap-super-admin.ts) — the Admin SDK bypasses
// Security Rules entirely, so these rules are defense-in-depth, not the
// real enforcement. Real enforcement is: (a) the client Firestore SDK is
// never used for these collections anywhere in the app, and (b) the
// `AuditLogRepository` port exposes no update/delete method at all, which
// is what actually makes audit logs append-only. Explicit deny blocks are
// listed per collection (rather than relying only on the wildcard below)
// so each Phase-2 collection's access decision is visible on its own.
//
// Phase 3 (catalog and inventory foundation) collections: `products`,
// `categories`, `brands`, `inventory`, `inventoryAdjustments`, and
// `catalogUniqueKeys` follow the exact same pattern — read and written
// exclusively by server-side code through the Admin SDK (see
// apps/web/src/infrastructure/firebase/repositories/*.ts), gated by RBAC
// permission checks in `services/catalog/*` before any repository call.
// There is no public storefront yet, so there's no reason for the client
// SDK to read these either — every catalog read in the admin UI goes
// through a Server Component/Action that calls these repositories
// server-side. `inventoryAdjustments` is append-only the same way
// `auditLogs` is: `InventoryAdjustmentRepository` exposes no update/delete
// method, and the only path that creates an entry is
// `InventoryRepository.adjust()`'s own transaction.
//
// Phase 5 (cart, checkout, delivery, pickup, payments, and order creation)
// collections: `carts`, `orders`, `orderEvents`, `payments`, `paymentEvents`,
// `inventoryReservations`, `checkoutIdempotency`, and `emailOutbox` follow
// the exact same pattern as every collection above — read and written
// exclusively by server-side code through the Admin SDK (see
// apps/web/src/infrastructure/firebase/repositories/*.ts), gated by
// service-layer validation/permission checks (`services/cart/*`,
// `services/checkout/*`, `services/payments/*`, `services/inventory/*`)
// before any repository call. There is no client-side Firestore access to
// a shopper's own cart or order anywhere in this app — even the guest
// cart cookie only carries an unforgeable id (see `lib/cart-cookie.ts`);
// the actual cart contents are always read/written server-side. `orders`
// and `payments` additionally hold private customer data (name, mobile,
// email, address), which is exactly why they stay fully denied here
// rather than being opened to "the owning shopper" — Phase 5 has no
// concept of an authenticated customer session to scope such a rule to
// (see README's Known limitations); public order tracking instead goes
// through `services/orders/track-order.ts`, a server-side use case that
// enforces its own mobile/email verification factor before returning only
// a redacted public-safe view. `orderEvents` and `paymentEvents` are
// append-only the same way `auditLogs`/`inventoryAdjustments` are — their
// repositories expose no update/delete method for the event itself.
//
// Phase 6 (order management, customers, inventory operations, admin
// dashboard) adds one new collection, `customers` — the same pattern as
// every collection above: read and written exclusively by server-side
// code through the Admin SDK (`infrastructure/firebase/repositories/
// firestore-customer-repository.ts`), gated by `customers:view`/
// `customers:manage` permission checks in `services/customers/*` before
// any repository call. It holds the same class of private customer data
// `orders`/`payments` already do (name, mobile, email), so it stays fully
// denied for the same reason those do — see the Phase 5 paragraph above.
// Every other Phase 6 read (order lists/detail, dashboard, reports) is
// server-computed from `orders`/`inventory*` collections already denied
// above; no new collection was needed for those.
//
// Phase 7 (customer accounts, CMS, wishlist, reviews, promotions) adds
// fourteen new collections: `customerAccounts`, `customerEmailVerifications`,
// `customerAddresses`, `wishlistItems`, `backInStockSubscriptions`,
// `notificationOutbox`, `reviews`, `reviewAggregates`, `productQuestions`,
// `cmsPages`, `siteSettings`, `coupons`, `couponRedemptions`, and
// `promotions`. Every one of them follows the exact same pattern as every
// collection above: read and written exclusively by server-side code
// through the Admin SDK (`infrastructure/firebase/repositories/*.ts`),
// gated by `services/*` — either a `requireCustomerSession()` ownership
// check (wishlist, addresses, reviews, questions, back-in-stock,
// email-verification, the customer's own account) or a
// `requirePermission()` RBAC check (CMS, site settings, coupons,
// promotions, review/question moderation, back-in-stock/notification-outbox
// admin views). Notably, a *signed-in customer's own* data
// (`customerAccounts`, `customerAddresses`, `wishlistItems`, etc.) is
// **not** opened to "the owning customer" here either, for the same
// reason `carts`/`orders` aren't in the Phase 5 paragraph above: there is
// no client-side Firestore access anywhere in this app, authenticated or
// not — every customer-facing read/write already goes through a Server
// Component/Action/Route Handler that resolves and enforces the session
// server-side (`services/customer-auth/session.ts#requireCustomerSession`),
// so a rule scoped to `request.auth.uid` would be redundant with, not a
// replacement for, that enforcement, and would need its own separate
// custom-claims wiring to even express (`request.auth.uid` is the Firebase
// Auth uid; nothing here uses Firestore Security Rules' custom-claims
// mechanism to distinguish "signed in as this customer" from "signed in as
// staff"). `reviewAggregates` and `notificationOutbox` hold no personal
// data at all but stay denied anyway, for consistency with every other
// collection's "no client SDK access, ever" baseline. `reviews` and
// `productQuestions` do have a public-safe read path
// (`services/reviews/list-product-reviews.ts`,
// `services/questions/list-questions.ts`, both approved-only) but that
// path is itself server-side (a Server Component calling the repository
// through the Admin SDK), never the client SDK reading Firestore directly
// — so the collection stays denied here too.
//
// Every other collection — anything belonging to a future module — stays
// on the Phase 1 default-deny baseline until that module designs its own
// real access pattern.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if false;
    }

    match /roles/{roleId} {
      allow read, write: if false;
    }

    match /auditLogs/{entryId} {
      allow read, write: if false;
    }

    match /system/{docId} {
      allow read, write: if false;
    }

    match /rateLimits/{key} {
      allow read, write: if false;
    }

    match /products/{productId} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      allow read, write: if false;
    }

    match /brands/{brandId} {
      allow read, write: if false;
    }

    match /inventory/{inventoryId} {
      allow read, write: if false;
    }

    match /inventoryAdjustments/{adjustmentId} {
      allow read, write: if false;
    }

    match /catalogUniqueKeys/{keyId} {
      allow read, write: if false;
    }

    match /carts/{cartId} {
      allow read, write: if false;
    }

    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /orderEvents/{eventId} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    match /inventoryReservations/{reservationId} {
      allow read, write: if false;
    }

    match /checkoutIdempotency/{key} {
      allow read, write: if false;
    }

    match /emailOutbox/{entryId} {
      allow read, write: if false;
    }

    match /customers/{customerId} {
      allow read, write: if false;
    }

    match /customerAccounts/{uid} {
      allow read, write: if false;
    }

    match /customerEmailVerifications/{tokenHash} {
      allow read, write: if false;
    }

    match /customerAddresses/{addressId} {
      allow read, write: if false;
    }

    match /wishlistItems/{itemId} {
      allow read, write: if false;
    }

    match /backInStockSubscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /notificationOutbox/{entryId} {
      allow read, write: if false;
    }

    match /reviews/{reviewId} {
      allow read, write: if false;
    }

    match /reviewAggregates/{productId} {
      allow read, write: if false;
    }

    match /productQuestions/{questionId} {
      allow read, write: if false;
    }

    match /cmsPages/{pageId} {
      allow read, write: if false;
    }

    match /siteSettings/{docId} {
      allow read, write: if false;
    }

    match /coupons/{code} {
      allow read, write: if false;
    }

    match /couponRedemptions/{redemptionId} {
      allow read, write: if false;
    }

    match /promotions/{promotionId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
