rules_version = '2';

// Phase 2 (auth/RBAC foundation) collections: `users`, `roles`, `auditLogs`,
// `system/bootstrap`, and `rateLimits` are all read and written exclusively
// by server-side code through the Firebase Admin SDK (see
// apps/web/src/infrastructure/firebase/repositories/*.ts and
// apps/web/scripts/bootstrap-super-admin.ts) — the Admin SDK bypasses
// Security Rules entirely, so these rules are defense-in-depth, not the
// real enforcement. Real enforcement is: (a) the client Firestore SDK is
// never used for these collections anywhere in the app, and (b) the
// `AuditLogRepository` port exposes no update/delete method at all, which
// is what actually makes audit logs append-only. Explicit deny blocks are
// listed per collection (rather than relying only on the wildcard below)
// so each Phase-2 collection's access decision is visible on its own.
//
// Phase 3 (catalog and inventory foundation) collections: `products`,
// `categories`, `brands`, `inventory`, `inventoryAdjustments`, and
// `catalogUniqueKeys` follow the exact same pattern — read and written
// exclusively by server-side code through the Admin SDK (see
// apps/web/src/infrastructure/firebase/repositories/*.ts), gated by RBAC
// permission checks in `services/catalog/*` before any repository call.
// There is no public storefront yet, so there's no reason for the client
// SDK to read these either — every catalog read in the admin UI goes
// through a Server Component/Action that calls these repositories
// server-side. `inventoryAdjustments` is append-only the same way
// `auditLogs` is: `InventoryAdjustmentRepository` exposes no update/delete
// method, and the only path that creates an entry is
// `InventoryRepository.adjust()`'s own transaction.
//
// Phase 5 (cart, checkout, delivery, pickup, payments, and order creation)
// collections: `carts`, `orders`, `orderEvents`, `payments`, `paymentEvents`,
// `inventoryReservations`, `checkoutIdempotency`, and `emailOutbox` follow
// the exact same pattern as every collection above — read and written
// exclusively by server-side code through the Admin SDK (see
// apps/web/src/infrastructure/firebase/repositories/*.ts), gated by
// service-layer validation/permission checks (`services/cart/*`,
// `services/checkout/*`, `services/payments/*`, `services/inventory/*`)
// before any repository call. There is no client-side Firestore access to
// a shopper's own cart or order anywhere in this app — even the guest
// cart cookie only carries an unforgeable id (see `lib/cart-cookie.ts`);
// the actual cart contents are always read/written server-side. `orders`
// and `payments` additionally hold private customer data (name, mobile,
// email, address), which is exactly why they stay fully denied here
// rather than being opened to "the owning shopper" — Phase 5 has no
// concept of an authenticated customer session to scope such a rule to
// (see README's Known limitations); public order tracking instead goes
// through `services/orders/track-order.ts`, a server-side use case that
// enforces its own mobile/email verification factor before returning only
// a redacted public-safe view. `orderEvents` and `paymentEvents` are
// append-only the same way `auditLogs`/`inventoryAdjustments` are — their
// repositories expose no update/delete method for the event itself.
//
// Every other collection — anything belonging to a future module — stays
// on the Phase 1 default-deny baseline until that module designs its own
// real access pattern.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if false;
    }

    match /roles/{roleId} {
      allow read, write: if false;
    }

    match /auditLogs/{entryId} {
      allow read, write: if false;
    }

    match /system/{docId} {
      allow read, write: if false;
    }

    match /rateLimits/{key} {
      allow read, write: if false;
    }

    match /products/{productId} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      allow read, write: if false;
    }

    match /brands/{brandId} {
      allow read, write: if false;
    }

    match /inventory/{inventoryId} {
      allow read, write: if false;
    }

    match /inventoryAdjustments/{adjustmentId} {
      allow read, write: if false;
    }

    match /catalogUniqueKeys/{keyId} {
      allow read, write: if false;
    }

    match /carts/{cartId} {
      allow read, write: if false;
    }

    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /orderEvents/{eventId} {
      allow read, write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    match /paymentEvents/{eventId} {
      allow read, write: if false;
    }

    match /inventoryReservations/{reservationId} {
      allow read, write: if false;
    }

    match /checkoutIdempotency/{key} {
      allow read, write: if false;
    }

    match /emailOutbox/{entryId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
