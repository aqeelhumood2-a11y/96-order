rules_version = '2';

// Phase 2 (auth/RBAC foundation) collections: `users`, `roles`, `auditLogs`,
// `system/bootstrap`, and `rateLimits` are all read and written exclusively
// by server-side code through the Firebase Admin SDK (see
// apps/web/src/infrastructure/firebase/repositories/*.ts and
// apps/web/scripts/bootstrap-super-admin.ts) — the Admin SDK bypasses
// Security Rules entirely, so these rules are defense-in-depth, not the
// real enforcement. Real enforcement is: (a) the client Firestore SDK is
// never used for these collections anywhere in the app, and (b) the
// `AuditLogRepository` port exposes no update/delete method at all, which
// is what actually makes audit logs append-only. Explicit deny blocks are
// listed per collection (rather than relying only on the wildcard below)
// so each Phase-2 collection's access decision is visible on its own.
//
// Phase 3 (catalog and inventory foundation) collections: `products`,
// `categories`, `brands`, `inventory`, `inventoryAdjustments`, and
// `catalogUniqueKeys` follow the exact same pattern — read and written
// exclusively by server-side code through the Admin SDK (see
// apps/web/src/infrastructure/firebase/repositories/*.ts), gated by RBAC
// permission checks in `services/catalog/*` before any repository call.
// There is no public storefront yet, so there's no reason for the client
// SDK to read these either — every catalog read in the admin UI goes
// through a Server Component/Action that calls these repositories
// server-side. `inventoryAdjustments` is append-only the same way
// `auditLogs` is: `InventoryAdjustmentRepository` exposes no update/delete
// method, and the only path that creates an entry is
// `InventoryRepository.adjust()`'s own transaction.
//
// Every other collection — anything belonging to a future module — stays
// on the Phase 1 default-deny baseline until that module designs its own
// real access pattern.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if false;
    }

    match /roles/{roleId} {
      allow read, write: if false;
    }

    match /auditLogs/{entryId} {
      allow read, write: if false;
    }

    match /system/{docId} {
      allow read, write: if false;
    }

    match /rateLimits/{key} {
      allow read, write: if false;
    }

    match /products/{productId} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      allow read, write: if false;
    }

    match /brands/{brandId} {
      allow read, write: if false;
    }

    match /inventory/{inventoryId} {
      allow read, write: if false;
    }

    match /inventoryAdjustments/{adjustmentId} {
      allow read, write: if false;
    }

    match /catalogUniqueKeys/{keyId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
