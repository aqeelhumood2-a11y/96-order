{
  "name": "96-order",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "build:shared": "pnpm --filter @96order/shared build",
    "dev": "pnpm run build:shared && pnpm --filter web dev",
    "build": "pnpm run build:shared && pnpm --filter functions build && pnpm --filter web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm run build:shared && pnpm -r typecheck",
    "test": "pnpm run build:shared && pnpm -r test",
    "test:e2e": "pnpm run build:shared && pnpm --filter web test:e2e",
    "emulators": "firebase emulators:start"
  }
}
