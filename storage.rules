rules_version = '2';

// Foundation-phase baseline: deny every read and write. Opened up per-path
// once each feature (product images, avatars, CMS assets, ...) defines its
// real access pattern.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
